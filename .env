# ─────────────────────────────────────────────────────────────
#  Audio Workstation — the ONE place to configure everything.
#  Edit, then apply with:  docker compose up -d --build
# ─────────────────────────────────────────────────────────────

# ── Network ──
# Port the web UI listens on: http://localhost:8080
PORT=8080
# 127.0.0.1 = only this computer can open the UI.
# 0.0.0.0   = any device on your network (phone, tablet). There is NO login, so only on a trusted network.
BIND_ADDRESS=127.0.0.1

# ── Storage ──
# Where songs, stems and collections live. Two choices:
#   audio-workstation-library      -> Docker-managed volume inside Docker (default, nothing to set up)
#   ./library               -> a folder next to this file, shared with your computer
#   /Users/you/Music/Stems  -> any absolute folder on your computer, shared with the host
LIBRARY=audio-workstation-library

# Max RAM the container may use. Splitting needs about 3-4 GB for a normal song.
MEMORY_LIMIT=6g

# ── Downloading ──
# MP3 bitrate (kbps) for the original song and the stems. 320 = highest MP3 quality.
MP3_BITRATE=320
# Update the YouTube downloader (yt-dlp) on every container start. YouTube changes often; keep this on.
YTDLP_AUTO_UPDATE=true

# ── Splitting ──
# htdemucs_6s = 6 tracks: vocals, drums, bass, guitar, piano, other (default)
# htdemucs    = 4 tracks: vocals, drums, bass, other (faster)
# htdemucs_ft = 4 tracks, best quality, about 4x slower
SPLIT_MODEL=htdemucs_6s

# ── Playback (song page) ──
SPEED_MIN=0.25
SPEED_MAX=1.5
SPEED_STEP=0.05
SPEED_DEFAULT=1.0
